AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Optional server-side provider only:
# AI_PROVIDER=openai_compatible
# OPENAI_BASE_URL=https://your-provider.example/v1
# OPENAI_API_KEY=replace_me
# OPENAI_MODEL=your-model

# TikTok Developer (server side)
TIKTOK_CLIENT_KEY=your_client_key
TIKTOK_CLIENT_SECRET=your_client_secret
TIKTOK_REDIRECT_URI=https://your-backend.example/oauth/tiktok/callback
TIKTOK_APP_RETURN_URI=tiktokai://oauth
TOKEN_DB=tokens.sqlite3
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace_with_fernet_key

# Optional automatic visuals. Keep provider keys on the server only.
IMAGE_PROVIDER=none

# Local Stable Diffusion WebUI:
# IMAGE_PROVIDER=automatic1111
# SD_WEBUI_URL=http://127.0.0.1:7860
# SD_STEPS=24
# SD_CFG_SCALE=7

# Pexels photographic stock provider:
# IMAGE_PROVIDER=pexels
# PEXELS_API_KEY=replace_me

# Persistent image cache:
VISUAL_CACHE_DIR=state/visual_cache


# Optional realistic talking presenter (server side only)
# Create a fictional or owned presenter image and host it at a public HTTPS URL.
# The default voice is an Arabic male Microsoft Neural voice.
# DID_API_KEY=replace_me
# DID_PRESENTER_URL=https://your-cdn.example/presenter-man-9x16.png
DID_VOICE_ID=ar-SY-LaithNeural
DID_VOICE_RATE=0.95
DID_TIMEOUT_SECONDS=120
